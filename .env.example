# Copy to .env for local development. In Render, set these values in the service environment.
# Never commit .env or real credentials.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET
OTP_PEPPER=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_CHAR_SECRET
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@YOUR_POSTGRES_HOST:5432/APP_DATABASE?sslmode=require
DB_POOL_MAX=12

CLINIC_NAME=Your Dental Hospital
CLINIC_CITY=Your City
CLINIC_COUNTRY=India
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_WHATSAPP=
CLINIC_TIMEZONE=Asia/Kolkata
BRANCH_NAME=Main Branch
DEFAULT_COUNTRY_CODE=91
PUBLIC_BASE_URL=https://YOUR_PUBLIC_DOMAIN
PATIENT_PORTAL_URL=https://YOUR_PUBLIC_DOMAIN/book
STAFF_PORTAL_URL=https://YOUR_PUBLIC_DOMAIN/staff
OTP_PORTAL_URL=https://YOUR_PUBLIC_DOMAIN/secure
# JSON array. Keep [] when all portals are served from the same origin.
CORS_ALLOWED_ORIGINS=[]

# Render persistent disk example: /var/data/private_uploads
STORAGE_DIR=./private_uploads
MAX_UPLOAD_BYTES=26214400
COOKIE_SECURE=false
DEMO_MODE=false

# Meta WhatsApp Business Cloud API. Configure approved templates before production.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
META_TEMPLATE_OTP=
META_TEMPLATE_CONFIRMATION=
META_TEMPLATE_PATIENT_CARD=
META_TEMPLATE_REMINDER_24H=
META_TEMPLATE_REMINDER_2H=
META_TEMPLATE_LANGUAGE=en

# SMS fallback: disabled, api, or twilio (as implemented by the selected provider).
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_TOKEN=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# Email OTP provider.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# OTP display helper is test/development only; keep false in production.
ALLOW_TEST_OTP=false

# Optional first admin bootstrap credentials. Use a unique password (12+ characters).
ADMIN_EMAIL=
ADMIN_MOBILE_10_DIGIT=
ADMIN_PASSWORD=
